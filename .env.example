# Copy these names into Railway > your service > Variables. Never commit real values.

# Required: the bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: your Telegram numeric id (ask @userinfobot) to use /admin and /aviso. Comma-separated.
ADMIN_IDS=

# Optional: time zone for clock times in messages (default UTC), e.g. America/Bogota
TIMEZONE=

# Optional: universe size and speed (defaults: 3 galaxies, 100 systems, x1, x1)
GALAXIES=
SYSTEMS=
ECONOMY_SPEED=
FLEET_SPEED=

# Optional: where the database is stored. On Railway, attaching a volume is enough.
DATA_DIR=
